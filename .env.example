# ---------------------------------------------------------------------------
# Скопировать в .env перед первым запуском:
#   cp .env.example .env  &&  docker compose up --build
#
# Ключи API не нужны: TTS_PROVIDER и LLM_PROVIDER по умолчанию = mock,
# всё поднимается и отвечает на /health на чистом клоне.
#
# Правило: любая переменная, которую читает код или docker-compose.yml,
# обязана присутствовать здесь. Рассинхрон этого файла с кодом — самая
# частая причина «у меня не собирается» (ровно на этом спотыкается
# референсный tatarby-main).
# ---------------------------------------------------------------------------

# --- Порты на хосте -------------------------------------------------------
GATEWAY_PORT=8000
SPEECH_PORT=8010
AI_PORT=8030
SCENARIO_PORT=8050
FRONTEND_PORT=8080          # прод-сборка (nginx)
VITE_PORT=5173              # dev-сервер vite (docker-compose.override.yml)

# --- Хранилище ------------------------------------------------------------
# SQLite-файлы лежат в ./data (bind-mount). Переезд на Postgres — это смена
# только этих двух строк плюс раскомментированный сервис в docker-compose.yml.
GATEWAY_DATABASE_URL=sqlite+aiosqlite:////data/gateway.db
SCENARIO_DATABASE_URL=sqlite+aiosqlite:////data/scenarios.db
# GATEWAY_DATABASE_URL=postgresql+asyncpg://ath:ath@postgres:5432/ath_sessions
# SCENARIO_DATABASE_URL=postgresql+asyncpg://ath:ath@postgres:5432/ath_scenarios
# POSTGRES_USER=ath
# POSTGRES_PASSWORD=ath

# --- TTS (Claude.md §10) --------------------------------------------------
# mock — генерирует тишину нужной длительности с реалистичной каденцией чанков;
# этого достаточно, чтобы проверить часы воспроизведения, липсинк и отмену.
# soniox — единственный по-настоящему реализованный провайдер, провалидирован
# веткой poc (голос "Nina", русский). elevenlabs/yandex остаются заглушками.
TTS_PROVIDER=mock           # mock | elevenlabs | yandex | soniox
TTS_VOICE_ID=
TTS_SAMPLE_RATE=24000
ELEVENLABS_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
SONIOX_API_KEY=
# Голос по умолчанию: используется, когда его не задали ни аватар
# (scenario-service/app/avatars/registry.json), ни персона сценария.
# Список доступных голосов: make voices
SONIOX_VOICE=Reese
SONIOX_LANGUAGE=ru

# --- STT / голосовой ввод -------------------------------------------------
# Для реального распознавания укажите soniox. Используется тот же серверный
# SONIOX_API_KEY; ключ никогда не передаётся во frontend.
# soniox_gigaam = Soniox primary with lossless replay to local GigaAM on failure.
STT_PROVIDER=mock           # mock | soniox | gigaam | soniox_gigaam
STT_LANGUAGE=ru
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_STT_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket
VOICE_MAX_CAPTURE_SECONDS=20
VOICE_MAX_FRAME_BYTES=32000

# Local GigaAM is optional and starts only with: docker compose --profile gigaam up --build
# Run `make gigaam-setup` first: the worker starts offline and refuses to
# download weights on its own.
# First start downloads model weights into a persistent Docker volume.
GIGAAM_PORT=8020
GIGAAM_WORKER_URL=http://gigaam-worker:8020
GIGAAM_TIMEOUT_SECONDS=60
STT_FINALIZE_TIMEOUT_SECONDS=5
# Управляемые сбои STT: позволяют прогнать failover до демо, не дожидаясь
# настоящего отказа сети. В обычной конфигурации эндпоинта не существует.
#   curl -X POST localhost:8010/debug/stt-fault -H 'Content-Type: application/json' \
#        -d '{"mode":"midturn"}'      # open | midturn | stall | off
STT_DEBUG_FAULTS_ENABLED=false
GIGAAM_MODEL=v3_e2e_ctc
GIGAAM_DEVICE=cpu
GIGAAM_MAX_CAPTURE_SECONDS=20
GIGAAM_QUEUE_SIZE=1

# --- LLM (Claude.md §5, разделение моделей) -------------------------------
# Быстрая модель — реплики персонажа, приоритет time to first token.
# Сильная — один вызов итоговой оценки со структурированным JSON.
# openai_compatible — второй провайдер (по итогам ветки poc): VseLLM или любой
# другой OpenAI-совместимый прокси. При его выборе LLM_FAST_MODEL/
# LLM_STRONG_MODEL должны быть именем модели ЭТОГО прокси, например
# "google/gemini-2.5-flash", а не именем модели Anthropic.
# ANTHROPIC_BASE_URL — не для OpenAI-совместимых прокси (для них ниже свой
# базовый URL): только для шлюзов, отдающих настоящий Anthropic Messages API
# (например, свой корпоративный роутер к Claude). Пусто = api.anthropic.com.
# Без /v1 на конце — SDK сам его дописывает.
LLM_PROVIDER=mock           # mock | anthropic | openai_compatible
LLM_FAST_MODEL=claude-haiku-4-5
LLM_STRONG_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_COMPATIBLE_BASE_URL=https://api.vsellm.ru/v1
OPENAI_COMPATIBLE_API_KEY=

# Альтернатива VseLLM: своя Ollama на удалённом сервере qamal@100.68.156.31
# (Tailscale IP), модель qwen3-14b-fast. Доступ — по SSH с локальным
# форвардингом порта (спросить доступ у команды, если его ещё нет):
#   ssh -L 11434:127.0.0.1:11434 qamal@100.68.156.31
# Дальше, пока туннель открыт:
#   OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_COMPATIBLE_API_KEY=ollama     (значение не проверяется, но поле обязательно)
#   LLM_FAST_MODEL=qwen3-14b-fast
#   LLM_STRONG_MODEL=qwen3-14b-fast
# Qwen3 — reasoning-модель: без явного отключения ризонинга TTFT растёт в разы
# (см. extra_body в app/llm/openai_compatible.py) — это уже сделано в коде,
# отдельно включать не нужно.

# --- Оркестратор ----------------------------------------------------------
MAX_CONTEXT_TURNS=6         # §5: полный текст последних N ходов + выжимка остального
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Фронтенд -------------------------------------------------------------
# Рендер аватара — TalkingHead + HeadAudio (Claude.md §10, по итогам ветки poc,
# заменяет прежний план на Simli). Оба self-hosted, без API-ключа и без
# управляемого сервиса — переменных для них поэтому нет.
#
# Адреса сервисов по умолчанию ПУСТЫЕ, и это рабочее состояние: браузер тогда
# ходит в /api, /ws, /scenario, /ai и /speech того же хоста, а разводит их
# прокси (services/frontend/nginx.conf в проде, vite.config.ts в dev).
#
# Так адрес перестаёт быть параметром сборки. Ради этого всё и сделано: с
# телефона микрофон работает только по HTTPS, а под HTTPS четыре сервиса на
# четырёх портах — это четыре туннеля и четыре сертификата, да ещё `ws://` со
# страницы по https браузер режет как mixed content. С одним origin достаточно
# одного туннеля на порт фронтенда:
#
#     cloudflared tunnel --url http://localhost:5173
#
# Заполнять эти переменные нужно ТОЛЬКО для прежней схемы, где браузер
# обращается в каждый сервис напрямую по его порту. Тогда не забыть CORS_ORIGINS
# выше: шлюз проверяет источник, остальные сервисы — нет.
# Dev-сервер Vite отвечает 403 на любой Host, кроме localhost, — туннель без
# этой переменной покажет на телефоне «Blocked request» и пустой экран.
# Прод-раздачи (nginx, порт 8080) это не касается.
VITE_ALLOWED_HOSTS=          # .trycloudflare.com | .ngrok-free.app | true
VITE_API_URL=
VITE_WS_URL=
VITE_SCENARIO_API_URL=
VITE_AI_API_URL=
VITE_SPEECH_WS_URL=

# --- Логи -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json             # json | console
