**/node_modules
**/dist
**/.vite
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info

.env
.env.*
!.env.example
