{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Дизайн-токены «Точка Ясности». Источник: продакшн-стили tochka-yasnosty.ru. Формат совместим со Style Dictionary и Tokens Studio for Figma.",
  "$version": "1.0.0",
  "color": {
    "bg": { "$value": "#EDF1F7", "$type": "color", "$description": "Фон страницы" },
    "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "Карточки, панели, модалки" },
    "surface2": { "$value": "#F4F7FB", "$type": "color", "$description": "Вложенные блоки внутри белой карточки" },
    "ink": { "$value": "#0C1A33", "$type": "color", "$description": "Основной текст и заголовки" },
    "ink2": { "$value": "#45536D", "$type": "color", "$description": "Вторичный текст, лиды" },
    "ink3": { "$value": "#5C6D89", "$type": "color", "$description": "Третичный текст, метки" },
    "line": { "$value": "#E2E8F2", "$type": "color", "$description": "Разделители и границы полей" },
    "blue": { "$value": "#2456E6", "$type": "color", "$description": "Основной акцент" },
    "blueDeep": { "$value": "#1B41C0", "$type": "color", "$description": "Hover основной кнопки" },
    "blueInk": { "$value": "#0E2A66", "$type": "color", "$description": "Текст на голубом фоне" },
    "blueSoft": { "$value": "#E9F0FF", "$type": "color", "$description": "Подложка иконок и eyebrow" },
    "blue100": { "$value": "#D9E5FA", "$type": "color", "$description": "Выделение текста, светлые заливки" },
    "navy": { "$value": "#0B1D4E", "$type": "color", "$description": "Тёмные блоки" },
    "navy2": { "$value": "#122E7E", "$type": "color", "$description": "Вторая точка тёмного градиента" },
    "btnGray": { "$value": "#E8EDF4", "$type": "color", "$description": "Заливка вторичной кнопки при hover" },
    "btnGrayHover": { "$value": "#DBE2EE", "$type": "color", "$description": "Усиленный hover вторичной кнопки" },
    "brandLogoBlue": { "$value": "#2757FC", "$type": "color", "$description": "Синий в SVG-логотипе, ярче UI-синего" },
    "white": { "$value": "#FFFFFF", "$type": "color" }
  },
  "gradient": {
    "navy": { "$value": "linear-gradient(150deg, #0B1D4E 0%, #122E7E 90%)", "$type": "gradient", "$description": "Тёмная bento-карточка" },
    "cta": { "$value": "linear-gradient(150deg, #0B1D4E 0%, #122E7E 85%)", "$type": "gradient", "$description": "CTA-блок" },
    "blueSoft": { "$value": "linear-gradient(150deg, #E6EFFC 0%, #C9DCF8 100%)", "$type": "gradient", "$description": "Голубая bento-карточка" },
    "subscribe": { "$value": "linear-gradient(150deg, #E6EFFC, #CBDDF8 60%, #BDD4F7)", "$type": "gradient", "$description": "Блок подписки" },
    "footer": { "$value": "linear-gradient(180deg, #E7EDF6 0%, #E0E8F3 100%)", "$type": "gradient", "$description": "Футер" },
    "btnWhite": { "$value": "linear-gradient(180deg, #FFFFFF 0%, #F0F4FA 100%)", "$type": "gradient", "$description": "Белая кнопка на тёмном фоне" }
  },
  "font": {
    "family": {
      "sans": { "$value": "Manrope, \"Segoe UI\", system-ui, -apple-system, sans-serif", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "display": { "$value": "clamp(38px, 4.3vw, 62px)", "$type": "dimension", "$description": "H1, макс. 62px" },
      "h2": { "$value": "clamp(30px, 3.1vw, 46px)", "$type": "dimension" },
      "h3": { "$value": "19px", "$type": "dimension" },
      "stat": { "$value": "clamp(33px, 2.9vw, 45px)", "$type": "dimension", "$description": "Крупная цифра метрики" },
      "lead": { "$value": "clamp(16px, 1.25vw, 18px)", "$type": "dimension" },
      "body": { "$value": "16px", "$type": "dimension" },
      "ui": { "$value": "15px", "$type": "dimension", "$description": "Кнопки и поля ввода" },
      "nav": { "$value": "14px", "$type": "dimension" },
      "caption": { "$value": "13.5px", "$type": "dimension" },
      "pill": { "$value": "12px", "$type": "dimension" },
      "micro": { "$value": "11px", "$type": "dimension" },
      "eyebrow": { "$value": "10px", "$type": "dimension" }
    },
    "lineHeight": {
      "tight": { "$value": 1.08, "$type": "number", "$description": "H1 и H2" },
      "heading": { "$value": 1.3, "$type": "number", "$description": "H3" },
      "body": { "$value": 1.6, "$type": "number" },
      "lead": { "$value": 1.7, "$type": "number" }
    },
    "letterSpacing": {
      "display": { "$value": "-0.03em", "$type": "dimension" },
      "h2": { "$value": "-0.035em", "$type": "dimension" },
      "h3": { "$value": "-0.015em", "$type": "dimension" },
      "ui": { "$value": "-0.01em", "$type": "dimension" },
      "eyebrow": { "$value": "0.14em", "$type": "dimension" }
    }
  },
  "radius": {
    "sm": { "$value": "14px", "$type": "dimension", "$description": "Строки списков" },
    "md": { "$value": "22px", "$type": "dimension", "$description": "Вложенные карточки" },
    "lg": { "$value": "32px", "$type": "dimension", "$description": "Карточка-секция, модалка" },
    "xl": { "$value": "40px", "$type": "dimension", "$description": "CTA, футер, подписка" },
    "pill": { "$value": "999px", "$type": "dimension" },
    "chip": { "$value": "18px", "$type": "dimension" },
    "icon": { "$value": "16px", "$type": "dimension", "$description": "Плитка иконки 48×48" },
    "field": { "$value": "13px", "$type": "dimension" },
    "topbar": { "$value": "22px", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "18px", "$type": "dimension" },
    "6": { "$value": "22px", "$type": "dimension" },
    "7": { "$value": "24px", "$type": "dimension", "$description": "Базовый зазор сетки (--gap)" },
    "8": { "$value": "26px", "$type": "dimension", "$description": "Внешний отступ оболочки (--pad)" },
    "9": { "$value": "30px", "$type": "dimension" },
    "10": { "$value": "38px", "$type": "dimension" },
    "11": { "$value": "44px", "$type": "dimension" },
    "12": { "$value": "56px", "$type": "dimension" }
  },
  "layout": {
    "shellMax": { "$value": "1774px", "$type": "dimension", "$description": "Максимальная ширина оболочки" },
    "pageMax": { "$value": "1460px", "$type": "dimension", "$description": "Максимальная ширина контентной колонки" },
    "sideWidth": { "$value": "264px", "$type": "dimension", "$description": "Ширина сайдбара" },
    "sectionPadding": { "$value": "clamp(34px, 3.6vw, 56px) clamp(28px, 3.4vw, 56px)", "$type": "dimension" },
    "cardPadding": { "$value": "clamp(26px, 2.6vw, 42px)", "$type": "dimension" },
    "ctaPadding": { "$value": "clamp(52px, 6vw, 92px) clamp(30px, 5vw, 80px)", "$type": "dimension" },
    "gridGap": { "$value": "18px", "$type": "dimension" },
    "statsGap": { "$value": "16px", "$type": "dimension" }
  },
  "breakpoint": {
    "xs": { "$value": "560px", "$type": "dimension", "$description": "Компактный телефон" },
    "sm": { "$value": "720px", "$type": "dimension", "$description": "Телефон: сетки в одну колонку, радиусы уменьшаются" },
    "md": { "$value": "900px", "$type": "dimension" },
    "lg": { "$value": "1120px", "$type": "dimension", "$description": "Ключевой: сайдбар превращается в topbar + бургер" },
    "xl": { "$value": "1280px", "$type": "dimension", "$description": "Сетки 3 → 2 колонки" },
    "xxl": { "$value": "1420px", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 8px 24px -10px rgba(14, 42, 102, 0.10)", "$type": "shadow" },
    "md": { "$value": "0 18px 44px -20px rgba(14, 42, 102, 0.14)", "$type": "shadow", "$description": "Карточка при hover, сайдбар" },
    "lg": { "$value": "0 32px 72px -32px rgba(14, 42, 102, 0.20)", "$type": "shadow" },
    "btnPrimary": { "$value": "0 1px 2px rgba(11, 29, 78, 0.26), 0 12px 28px -14px rgba(11, 29, 78, 0.48)", "$type": "shadow" },
    "btnPrimaryHover": { "$value": "0 2px 3px rgba(11, 29, 78, 0.22), 0 16px 34px -14px rgba(11, 29, 78, 0.52)", "$type": "shadow" },
    "btnWhite": { "$value": "inset 0 1px 0 #FFFFFF, 0 12px 34px rgba(4, 16, 46, 0.22)", "$type": "shadow" },
    "modal": { "$value": "0 44px 110px -34px rgba(4, 16, 46, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.9)", "$type": "shadow" }
  },
  "border": {
    "ringSecondary": { "$value": "inset 0 0 0 1.5px #C5D3E8", "$type": "shadow", "$description": "Контур вторичной кнопки" },
    "ringSecondaryHover": { "$value": "inset 0 0 0 1.5px #B7C7E2", "$type": "shadow" },
    "ringArrow": { "$value": "inset 0 0 0 1.5px #C9D6EA", "$type": "shadow", "$description": "Контур круглой кнопки-стрелки" },
    "ringEyebrow": { "$value": "inset 0 0 0 1px rgba(36, 86, 230, 0.16)", "$type": "shadow" },
    "focusRing": { "$value": "3px solid rgba(36, 86, 230, 0.45)", "$type": "border", "$description": "outline-offset: 2px" },
    "glass": { "$value": "1px solid rgba(255, 255, 255, 0.7)", "$type": "border" }
  },
  "glass": {
    "bg": { "$value": "rgba(255, 255, 255, 0.82)", "$type": "color", "$description": "Сайдбар и topbar" },
    "bgChip": { "$value": "rgba(255, 255, 255, 0.58)", "$type": "color", "$description": "Парящий чип" },
    "blur": { "$value": "blur(24px) saturate(160%)", "$type": "other" },
    "blurChip": { "$value": "blur(22px) saturate(165%)", "$type": "other" },
    "innerHighlight": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.9)", "$type": "shadow" }
  },
  "motion": {
    "easing": {
      "ui": { "$value": "cubic-bezier(0.22, 0.72, 0.24, 1)", "$type": "cubicBezier", "$description": "Интерфейсные переходы" },
      "soft": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier", "$description": "Появление контента" }
    },
    "duration": {
      "instant": { "$value": "100ms", "$type": "duration", "$description": ":active" },
      "fast": { "$value": "250ms", "$type": "duration", "$description": "Кнопки, поля" },
      "base": { "$value": "350ms", "$type": "duration", "$description": "Иконки, строки списков" },
      "slow": { "$value": "450ms", "$type": "duration", "$description": "Карточки" },
      "modal": { "$value": "650ms", "$type": "duration" },
      "reveal": { "$value": "900ms", "$type": "duration", "$description": "Появление секции при скролле" }
    },
    "stagger": {
      "start": { "$value": "100ms", "$type": "duration" },
      "step": { "$value": "40ms", "$type": "duration" }
    }
  },
  "size": {
    "iconButton": { "$value": "17px", "$type": "dimension" },
    "iconPill": { "$value": "13px", "$type": "dimension" },
    "iconTile": { "$value": "48px", "$type": "dimension" },
    "arrowButton": { "$value": "44px", "$type": "dimension" },
    "iconBadge": { "$value": "30px", "$type": "dimension" },
    "brandMark": { "$value": "34px", "$type": "dimension" }
  }
}
